# Build output
.build/
.swiftpm/
DerivedData/
dist/

# macOS metadata
.DS_Store
._*
**/._*

# Runtime logs
*.log

# Local user media.
# Keep the folder and placeholder docs, but never publish private videos/images.
视频/*
!视频/.gitkeep
!视频/README.md
!视频/视频素材/
视频/视频素材/*
!视频/视频素材/.gitkeep
!视频/视频素材/README.md

# Common media extensions in case assets are placed elsewhere.
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.aac
*.flac
*.jpg
*.jpeg
*.png
*.gif
*.heic

# Keep public docs/placeholders if they are intentionally added.
!README.md
!**/README.md
!**/.gitkeep
